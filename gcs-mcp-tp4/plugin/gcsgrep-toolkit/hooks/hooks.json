{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_gcsgrep-toolkit_gcs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/gcs-allowlist.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/artefactos-inmutables.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/regresion-antes-de-commit.py\""
          }
        ]
      }
    ]
  }
}
